+++ b/archive/phase_0_1/src/marketlab/rules/broker.py
@@ -0,0 +1,88 @@
+"""Zerodha / Kite Connect rules relevant to order validation (observed 2026-11-04)."""
+
+from __future__ import annotations
+
+from collections import deque
+from dataclasses import dataclass, field
+from datetime import date, datetime, time, timedelta
+from decimal import Decimal
+
+from .provenance import Cite, Status
+from .sessions import CAS_FROM
+from .types import IST, RuleUnknown
+
+# ---- MIS (intraday) auto square-off ----------------------------------------------------------
+
+MIS_CUTOFF_CITE = Cite(("ZERODHA/CAS",), Status.BROKER_OFFICIAL,
+                       "From 3 Aug 2026: MIS auto square-off 15:12 for F&O (CAS) stocks, 15:25 for other stocks. "
+                       "New MIS orders are rejected after the cut-off.")
+
+
+def mis_cutoff(on: date, has_derivatives: bool | None) -> time:
+    if on < CAS_FROM:
+        raise RuleUnknown("MIS cut-off before 3 Aug 2026 is not verified (sources show both 15:20 and 15:25)")
+    if has_derivatives is None:
+        raise RuleUnknown("F&O status unknown, so the MIS cut-off is unknown")
+    return time(15, 12) if has_derivatives else time(15, 25)
+
+
+# ---- Kite Connect order API -----------------------------------------------------------------
+
+MARKET_PROTECTION_CITE = Cite(("ZERODHA/KITE-API-FAQ", "KITE/ORDERS", "NSE/CMTR/68802"), Status.BROKER_OFFICIAL,
+                              "API MARKET and SL-M orders must carry market_protection (-1 auto or >0..100 %); 0 is "
+                              "rejected. Kite converts them to protected limit orders; NSE pre-emptively rejects "
+                              "true algo market orders in the normal market from 7 Jul 2025.")
+RATE_LIMIT_CITE = Cite(("KITE/LIMITS", "ZERODHA/KITE-API-FAQ"), Status.BROKER_OFFICIAL,
+                       "10 orders/second per client account (HTTP 429 beyond; invalid requests count), 400/minute, "
+                       "5,000/day per user or API key, 25 modifications per order.")
+STATIC_IP_CITE = Cite(("ZERODHA/STATIC-IP", "ZERODHA/KITE-API-FAQ"), Status.CONFLICTING,
+                      "Static IP required for API order placement. The static-IP article says from 1 Apr 2026; the "
+                      "API FAQ says 1 Apr 2025. Either way it is in force now. Max 2 IPs, 1 change per week.")
+TAG_MAX_LEN = 20
+ORDERS_PER_SECOND = 10
+ORDERS_PER_MINUTE = 400
+ORDERS_PER_DAY = 5000
+MODIFICATIONS_PER_ORDER = 25
+
+
+def market_protection_valid(pct: Decimal | None) -> bool:
+    if pct is None:
+        return False
+    return pct == Decimal("-1") or Decimal("0") < pct <= Decimal("100")
+
+
+def tag_valid(tag: str | None) -> bool:
+    return tag is None or (0 < len(tag) <= TAG_MAX_LEN and tag.isascii() and tag.isalnum())
+
+
+@dataclass
+class OrderRateLimiter:
+    """Deterministic limiter for simulated order submission (no wall clock).
+
+    Callers must pass *every* request that reaches the broker, including ones our own validation
+    would reject, because Kite counts blocked invalid requests too. Requests refused here (the
+    simulated HTTP 429) are not counted: ASSUMPTION, not stated by Kite.
+    The daily window is the IST date of the timestamp.
+    """
+
+    _second: deque[datetime] = field(default_factory=deque)
+    _minute: deque[datetime] = field(default_factory=deque)
+    _day: date | None = None
+    _day_count: int = 0
+
+    def try_acquire(self, ts: datetime) -> bool:
+        if ts.tzinfo is None:
+            raise ValueError("Timestamp must be timezone-aware")
+        for q, width in ((self._second, timedelta(seconds=1)), (self._minute, timedelta(minutes=1))):
+            while q and ts - q[0] >= width:
+                q.popleft()
+        d = ts.astimezone(IST).date()
+        if d != self._day:
+            self._day, self._day_count = d, 0
+        allowed = (len(self._second) < ORDERS_PER_SECOND and len(self._minute) < ORDERS_PER_MINUTE
+                   and self._day_count < ORDERS_PER_DAY)
+        if allowed:
+            self._second.append(ts)
+            self._minute.append(ts)
+            self._day_count += 1
+        return allowed
diff --git a/archive/phase_0_1/src/marketlab/rules/calendar.py b/archive/phase_0_1/src/marketlab/rules/calendar.py
new file mode 100644
index 0000000..bc6b52e
--- /dev/null
+++ b/archive/phase_0_1/src/marketlab/rules/calendar.py
@@ -0,0 +1,133 @@
+"""Trading and settlement calendars.
+
+Only years whose holiday lists were read from an official source are loaded. Any date
+outside a loaded year raises ``RuleUnknown`` so that replay over unloaded history fails
+loudly instead of silently treating every weekday as a trading day.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import date, timedelta
+
+from .provenance import Cite, Status
+from .types import Exchange, RuleUnknown
+
+T_PLUS_1_FROM = date(2023, 1, 27)
+T_PLUS_1_CITE = Cite(("NSE/CMTR/73927",), Status.PRIMARY,
+                     "All securities moved to T+1 rolling settlement effective 27 Jan 2023 (section 1.5).")
+
+
+@dataclass(frozen=True, slots=True)
+class CalendarYear:
+    exchange: Exchange
+    year: int
+    trading_holidays: frozenset[date]  # weekday closures
+    settlement_holidays: frozenset[date]  # weekday settlement closures (superset of most trading holidays)
+    special_sessions: frozenset[date] = frozenset()  # weekend sessions (e.g. Muhurat); timings separate
+    cites: tuple[Cite, ...] = field(default=())
+
+
+def _d(s: str) -> date:
+    return date.fromisoformat(s)
+
+
+NSE_2026 = CalendarYear(
+    exchange=Exchange.NSE,
+    year=2026,
+    trading_holidays=frozenset(map(_d, [
+        "2026-01-15",  # Maharashtra municipal elections (ad hoc; announced Jan 2026)
+        "2026-01-26", "2026-03-03", "2026-03-26", "2026-03-31", "2026-04-03", "2026-04-14",
+        "2026-05-01", "2026-05-28", "2026-06-26", "2026-09-14", "2026-10-02", "2026-10-20",
+        "2026-11-10", "2026-11-24", "2026-12-25",
+    ])),
+    settlement_holidays=frozenset(map(_d, [
+        "2026-01-15",
+        "2026-01-26", "2026-02-19", "2026-03-03", "2026-03-19", "2026-03-26", "2026-03-31",
+        "2026-04-01", "2026-04-03", "2026-04-14", "2026-05-01", "2026-05-28", "2026-06-26",
+        "2026-08-26", "2026-09-14", "2026-10-02", "2026-10-20", "2026-11-10", "2026-11-24",
+        "2026-12-25",
+    ])),
+    special_sessions=frozenset({_d("2026-11-08")}),  # Muhurat trading (Sunday); timings not yet notified
+    cites=(
+        Cite(("NSE/CMTR/73927",), Status.PRIMARY, "15 weekday trading holidays for 2026 (section 2.1)."),
+        Cite(("NCL/CMPT/71904",), Status.PRIMARY, "19 weekday settlement holidays for 2026."),
+        Cite(("NSE/2026-01-15-HOLIDAY",), Status.SECONDARY,
+             "15 Jan 2026 ad hoc trading and settlement holiday; NSE original not yet read."),
+    ),
+)
+
+DEFAULT_YEARS: tuple[CalendarYear, ...] = (NSE_2026,)
+
+
+class MarketCalendar:
+    def __init__(self, years: tuple[CalendarYear, ...] = DEFAULT_YEARS) -> None:
+        self._years: dict[tuple[Exchange, int], CalendarYear] = {}
+        for y in years:
+            key = (y.exchange, y.year)
+            if key in self._years:
+                raise ValueError(f"Duplicate calendar for {key}")
+            for d in y.trading_holidays | y.settlement_holidays:
+                if d.year != y.year:
+                    raise ValueError(f"{d} is outside calendar year {y.year}")
+                if d.weekday() >= 5:
+                    raise ValueError(f"{d} is a weekend; list weekday holidays only")
+            self._years[key] = y
+
+    def year(self, exchange: Exchange, d: date) -> CalendarYear:
+        try:
+            return self._years[(exchange, d.year)]
+        except KeyError:
+            raise RuleUnknown(f"No verified {exchange} calendar loaded for {d.year}") from None
+
+    def covers(self, exchange: Exchange, d: date) -> bool:
+        return (exchange, d.year) in self._years
+
+    def is_special_session(self, exchange: Exchange, d: date) -> bool:
+        return d in self.year(exchange, d).special_sessions
+
+    def is_trading_day(self, exchange: Exchange, d: date) -> bool:
+        """Regular trading day. Weekend special sessions (Muhurat) return False here."""
+        y = self.year(exchange, d)
+        return d.weekday() < 5 and d not in y.trading_holidays
+
+    def is_settlement_day(self, exchange: Exchange, d: date) -> bool:
+        y = self.year(exchange, d)
+        return d.weekday() < 5 and d not in y.settlement_holidays
+
+    def next_trading_day(self, exchange: Exchange, d: date) -> date:
+        n = d + timedelta(days=1)
+        while not self.is_trading_day(exchange, n):
+            n += timedelta(days=1)
+        return n
+
+    def previous_trading_day(self, exchange: Exchange, d: date) -> date:
+        p = d - timedelta(days=1)
+        while not self.is_trading_day(exchange, p):
+            p -= timedelta(days=1)
+        return p
+
+    def settlement_date(self, exchange: Exchange, trade_date: date) -> date:
+        """T+1: the first settlement working day strictly after the trade date.
+
+        Derived from the T+1 rule plus the settlement-holiday list; NSE also publishes monthly
+        settlement calendars, which should be loaded and compared once data ingestion exists.
+        """
+        if trade_date < T_PLUS_1_FROM:
+            raise RuleUnknown("Settlement cycles before 27 Jan 2023 (phased T+2/T+1) are not modelled")
+        n = trade_date + timedelta(days=1)
+        while not self.is_settlement_day(exchange, n):
+            n += timedelta(days=1)
+        return n
+
+    def is_first_trading_day_of_week(self, exchange: Exchange, d: date) -> bool:
+        """'Every Monday / 1st trading day of the week' (GSM III/IV, IBC II once-a-week trading)."""
+        if not self.is_trading_day(exchange, d):
+            return False
+        monday = d - timedelta(days=d.weekday())
+        cur = monday
+        while cur < d:
+            if self.is_trading_day(exchange, cur):
+                return False
+            cur += timedelta(days=1)
+        return True
diff --git a/archive/phase_0_1/src/marketlab/rules/charges.py b/archive/phase_0_1/src/marketlab/rules/charges.py
new file mode 100644
index 0000000..f3eceae
--- /dev/null
+++ b/archive/phase_0_1/src/marketlab/rules/charges.py
@@ -0,0 +1,164 @@
+"""Zerodha equity charge schedule (snapshot observed 2026-11-04) and per-order charge computation.
+
+Rounding is an explicit ASSUMPTION until reconciled with real contract notes: each component is
+computed at full precision and rounded to the paisa (half-up); GST is computed on the unrounded
+GST base and then rounded. Contract notes may round STT/stamp differently.
+
+Applying this schedule to dates before ``observed_on`` is a *current-rule counterfactual* and is
+flagged as such by ``order_charges``.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import date
+from decimal import ROUND_HALF_UP, Decimal
+from enum import StrEnum
+
+from .provenance import Cite, Status
+from .types import Exchange, Side
+
+D = Decimal
+PAISA = D("0.01")
+CRORE = D("10000000")
+
+
+class TradeKind(StrEnum):
+    DELIVERY = "DELIVERY"  # CNC, including BTST
+    INTRADAY = "INTRADAY"  # MIS, or a CNC buy and sell of the same shares on the same day
+    MTF = "MTF"
+
+
+@dataclass(frozen=True, slots=True)
+class Brokerage:
+    pct: Decimal  # percent of order turnover
+    cap: Decimal | None  # rupees per executed order
+
+
+@dataclass(frozen=True, slots=True)
+class ChargeSchedule:
+    observed_on: date
+    brokerage: dict[TradeKind, Brokerage]
+    stt_pct: dict[tuple[TradeKind, Side], Decimal]
+    stamp_buy_pct: dict[TradeKind, Decimal]
+    nse_txn_pct: Decimal
+    bse_txn_pct_by_group: dict[str, Decimal]
+    bse_txn_pct_default: Decimal
+    sebi_per_crore: Decimal
+    nse_ipft_per_crore: Decimal
+    gst_pct: Decimal
+    dp_charge_per_scrip_incl_gst: Decimal
+    mtf_pledge_fee: Decimal  # + GST, per pledge request per ISIN (once per buy day)
+    mtf_unpledge_fee: Decimal  # + GST, per unpledge request per ISIN
+    auto_square_off_fee: Decimal  # + GST, per order squared off by the broker's dealer
+    cites: tuple[Cite, ...] = field(default=())
+
+
+ZERODHA_2026_11_04 = ChargeSchedule(
+    observed_on=date(2026, 11, 4),
+    brokerage={
+        TradeKind.DELIVERY: Brokerage(D("0"), None),
+        TradeKind.INTRADAY: Brokerage(D("0.03"), D("20")),
+        TradeKind.MTF: Brokerage(D("0.3"), D("20")),
+    },
+    stt_pct={
+        (TradeKind.DELIVERY, Side.BUY): D("0.1"), (TradeKind.DELIVERY, Side.SELL): D("0.1"),
+        (TradeKind.INTRADAY, Side.BUY): D("0"), (TradeKind.INTRADAY, Side.SELL): D("0.025"),
+        (TradeKind.MTF, Side.BUY): D("0.1"), (TradeKind.MTF, Side.SELL): D("0.1"),
+    },
+    stamp_buy_pct={TradeKind.DELIVERY: D("0.015"), TradeKind.INTRADAY: D("0.003"), TradeKind.MTF: D("0.015")},
+    nse_txn_pct=D("0.00307"),
+    bse_txn_pct_by_group={
+        # Rs 10,000 per crore = 0.1%
+        "X": D("0.1"), "XT": D("0.1"), "Z": D("0.1"), "ZP": D("0.1"),
+        # Rs 1,00,000 per crore = 1%
+        "SS": D("1"), "ST": D("1"),
+        # Rs 275 per crore = 0.00275%
+        "M": D("0.00275"), "MT": D("0.00275"), "TS": D("0.00275"), "MS": D("0.00275"),
+    },
+    bse_txn_pct_default=D("0.00375"),
+    sebi_per_crore=D("10"),
+    nse_ipft_per_crore=D("0.01"),
+    gst_pct=D("18"),
+    dp_charge_per_scrip_incl_gst=D("15.34"),
+    mtf_pledge_fee=D("15"),
+    mtf_unpledge_fee=D("15"),
+    auto_square_off_fee=D("50"),
+    cites=(
+        Cite(("ZERODHA/CHARGES",), Status.BROKER_OFFICIAL, "All rates as listed on 2026-11-04."),
+        Cite(("ZERODHA/CHARGES",), Status.ASSUMPTION,
+             "MTF STT and stamp duty use the delivery rates (MTF is a delivery purchase); not stated explicitly."),
+        Cite(("ZERODHA/CHARGES",), Status.ASSUMPTION,
+             "Per-component paisa rounding (half-up); GST on the unrounded base. Reconcile with contract notes."),
+        Cite(("ZERODHA/CHARGES",), Status.ASSUMPTION,
+             "DP charge applied once per ISIN per sell date ('per scrip, irrespective of quantity')."),
+        Cite(("ZERODHA/CHARGES",), Status.UNKNOWN,
+             "Whether the Rs 20/order debit-balance surcharge applies to MTF-funded accounts is not determined."),
+    ),
+)
+
+
+def _r(x: Decimal) -> Decimal:
+    return x.quantize(PAISA, rounding=ROUND_HALF_UP)
+
+
+@dataclass(frozen=True, slots=True)
+class ChargeBreakdown:
+    turnover: Decimal
+    brokerage: Decimal
+    stt: Decimal
+    exchange_txn: Decimal
+    sebi: Decimal
+    ipft: Decimal
+    stamp: Decimal
+    gst: Decimal
+    counterfactual: bool  # schedule applied to a date before it was observed
+
+    @property
+    def total(self) -> Decimal:
+        return self.brokerage + self.stt + self.exchange_txn + self.sebi + self.ipft + self.stamp + self.gst
+
+
+def order_charges(schedule: ChargeSchedule, *, exchange: Exchange, kind: TradeKind, side: Side,
+                  price: Decimal, quantity: int, trade_date: date, bse_group: str | None = None) -> ChargeBreakdown:
+    """Charges for one executed order (all its fills), excluding DP/pledge charges which are per day/ISIN."""
+    if quantity <= 0 or price <= 0:
+        raise ValueError("price and quantity must be positive")
+    turnover = price * quantity
+    b = schedule.brokerage[kind]
+    brokerage_raw = turnover * b.pct / 100
+    if b.cap is not None:
+        brokerage_raw = min(brokerage_raw, b.cap)
+    stt_raw = turnover * schedule.stt_pct[(kind, side)] / 100
+    if exchange is Exchange.NSE:
+        txn_pct = schedule.nse_txn_pct
+        ipft_raw = turnover * schedule.nse_ipft_per_crore / CRORE
+    else:
+        if bse_group is None:
+            raise ValueError("BSE charges depend on the scrip group; pass bse_group")
+        txn_pct = schedule.bse_txn_pct_by_group.get(bse_group.upper(), schedule.bse_txn_pct_default)
+        ipft_raw = D("0")
+    txn_raw = turnover * txn_pct / 100
+    sebi_raw = turnover * schedule.sebi_per_crore / CRORE
+    stamp_raw = turnover * schedule.stamp_buy_pct[kind] / 100 if side is Side.BUY else D("0")
+    gst_raw = (brokerage_raw + txn_raw + sebi_raw + ipft_raw) * schedule.gst_pct / 100
+    return ChargeBreakdown(
+        turnover=turnover,
+        brokerage=_r(brokerage_raw),
+        stt=_r(stt_raw),
+        exchange_txn=_r(txn_raw),
+        sebi=_r(sebi_raw),
+        ipft=_r(ipft_raw),
+        stamp=_r(stamp_raw),
+        gst=_r(gst_raw),
+        counterfactual=trade_date < schedule.observed_on,
+    )
+
+
+def with_gst(schedule: ChargeSchedule, fee: Decimal) -> Decimal:
+    return _r(fee * (1 + schedule.gst_pct / 100))
+
+
+def dp_charges(schedule: ChargeSchedule, sell_days: set[tuple[str, date]]) -> Decimal:
+    """DP charge for delivery/MTF sells: one charge per (ISIN, sell date). Not charged on MIS."""
+    return schedule.dp_charge_per_scrip_incl_gst * len(sell_days)
diff --git a/archive/phase_0_1/src/marketlab/rules/demo.py b/archive/phase_0_1/src/marketlab/rules/demo.py
