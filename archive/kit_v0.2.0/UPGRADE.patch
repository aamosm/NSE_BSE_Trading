-def evaluate_order(
-    order: OrderRequest,
-    inst: InstrumentSnapshot,
-    position: PositionState,
-    account: AccountState,
-    *,
-    calendar: MarketCalendar,
-    policy: Policy | None = None,
-) -> Decision:
-    pol = policy or Policy()
