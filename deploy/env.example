# /var/lib/marketlab/private/.env  (owner marketlab, mode 0600). Typed on the server; never committed or sent anywhere.
# Only these keys are accepted. Any key whose name contains PASSWORD, PASSWD, PIN, TOTP or OTP is refused.
# Never store your Zerodha password, PIN or TOTP seed under any name.
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
# Must equal the redirect URL registered on developers.kite.trade, character for character.
KITE_REDIRECT_URL=https://YOUR-SERVER.YOUR-TAILNET.ts.net/kite/callback
# Optional: only this Tailscale login may open the app (Tailscale Serve identity header).
MARKETLAB_TAILNET_USER=
# Optional: healthchecks.io ping URL (independent monitor; alerts you if the server goes silent).
MARKETLAB_HEARTBEAT_URL=
# Optional: ntfy topic URL for state-change alerts (fixed text, no account data). Use an unguessable topic.
MARKETLAB_ALERT_URL=
