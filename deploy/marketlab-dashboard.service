[Unit]
Description=MarketLab private research status page
After=network.target

[Service]
Type=simple
User=marketlab
Group=marketlab
WorkingDirectory=/opt/marketlab
ExecStart=/opt/marketlab/.venv/bin/python -m marketlab --private-dir /var/lib/marketlab dashboard --port 8765
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/marketlab
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
