[Unit]
Description=MarketLab read-only Kite collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marketlab
Group=marketlab
WorkingDirectory=/opt/marketlab
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/marketlab/.venv/bin/python -m marketlab --private-dir /var/lib/marketlab watch --interval 300
Restart=on-failure
RestartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/marketlab
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
